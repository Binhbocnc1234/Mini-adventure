MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7767994365017264638}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e8d38646239773e40b948649152e65ee, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  fullText: 'O ancestors who rest in the sacred place,

    Please listen to our
    prayers.

    We offer this gift in gratitude.

    Please bless this land with
    prosperity,

    Give us strength to face the darkness,

    And guide us on
